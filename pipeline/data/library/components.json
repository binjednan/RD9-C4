 "joint_policy": {
  "steel": {
   "<=40": "threaded",
   "50": "flanged_or_threaded_assumed_flanged",
   "65+": "flanged_at_valves_grooved_on_runs"
  },
  "ppr": "socket_coupling",
  "pex": "compression",
  "upvc": "socket_coupling",
  "hdpe": "clamp_coupling"
